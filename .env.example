# App
APP_NAME=AI Content Automation System
SECRET_KEY=change-me
DEFAULT_TIMEZONE=UTC
DATABASE_PATH=content_automation.db
# ollama (local, free), openai (any OpenAI-compatible API) or huggingface
AI_PROVIDER=ollama
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=900
# Optional: make the posts sound like you
BRAND_VOICE=
BRAND_AUDIENCE=

ENABLE_TWITTER=true
ENABLE_LINKEDIN=true
ENABLE_TELEGRAM=true
ENABLE_EMAIL=true
ENABLE_INSTAGRAM=true

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=mistral

# OpenAI-compatible provider (used when AI_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# HuggingFace provider (needs scripts/requirements-huggingface.txt)
HF_MODEL=facebook/bart-large-cnn

# Twitter
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# LinkedIn
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=
LINKEDIN_POST_URL=

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Email
EMAIL_USER=
EMAIL_PASSWORD=
EMAIL_RECIPIENT=
